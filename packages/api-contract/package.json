{
  "name": "@waterlily/api-contract",
  "version": "0.0.0",
  "private": true,
  "description": "Runtime-validated local service contract for WaterLily",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test vitest.config.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@waterlily/context-engine": "workspace:*",
    "@waterlily/domain": "workspace:*",
    "@waterlily/interchange": "workspace:*",
    "@waterlily/providers": "workspace:*"
  }
}
