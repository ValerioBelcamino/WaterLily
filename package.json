{
  "name": "llm-graph-workbench",
  "version": "0.0.0",
  "private": true,
  "description": "A local-first, provider-neutral conversation graph workbench",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "eslint e2e playwright.config.ts && tsc -p tsconfig.json --noEmit && turbo run lint typecheck test",
    "dev:server": "pnpm --filter @llm-graph/server dev",
    "dev:web": "pnpm --filter @llm-graph/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint e2e playwright.config.ts && turbo run lint",
    "start:server": "pnpm --filter @llm-graph/server start",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "pnpm build && playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit && turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "fast-check": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
