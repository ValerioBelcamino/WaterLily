# Never commit real credentials. Provider secrets are read only by the local
# loopback service; the browser client never receives them.
WATERLILY_HOST=127.0.0.1
WATERLILY_PORT=4317
WATERLILY_DATABASE_PATH=../../.data/waterlily.sqlite
# Optional overrides; defaults are derived from the database path.
# WATERLILY_ATTACHMENTS_PATH=../../.data/attachments
# WATERLILY_PYTHON_WORKSPACES_PATH=../../.data/python
# WATERLILY_PYTHON_EXECUTABLE=python3
# Stored-key default: $XDG_DATA_HOME/waterlily/credentials.json
# WATERLILY_CREDENTIALS_PATH=/absolute/path/to/credentials.json

OPENAI_API_KEY=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# OpenAI-compatible local servers such as Ollama, vLLM, and LM Studio.
# Example: http://127.0.0.1:11434/v1
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=

# This affects only explicit provider and full-service live integration tests.
RUN_LIVE_PROVIDER_TESTS=0
